# ============================================================================
# Environment Configuration — SEKELAS Class App
# Salin file ini menjadi .env dan sesuaikan dengan environment deployment.
# ============================================================================

# --- Server ---
PORT=5000
NODE_ENV=development          # development | production
API_BASE_URL=http://localhost:5000/api
FRONTEND_URL=http://localhost:5173

# --- Security ---
JWT_ACCESS_SECRET=ganti_dengan_random_string_panjang_min_32_karakter
JWT_ACCESS_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# --- Database (Pilih salah satu MODE) ---------------------------------------
# MODE LOKAL (offline di sekolah via Docker / XAMPP / Laragon)
# Contoh PostgreSQL via Docker:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sekelas_db?schema=public"
# Contoh MySQL via XAMPP/Laragon (ubah provider prisma menjadi "mysql"):
# DATABASE_URL="mysql://root:@localhost:3306/sekelas_db"

# MODE ONLINE (cloud / production)
# Supabase (PostgreSQL):
# DATABASE_URL="postgresql://postgres:[password]-[project-ref].aws.supabase.co:5432/postgres"
# Railway / VPS PostgreSQL:
# DATABASE_URL="postgresql://user:pass@host:5432/dbname?sslmode=require"

# --- File Upload (opsional) ---
MAX_FILE_SIZE=5242880         # 5 MB
UPLOAD_DIR=./uploads

# --- CORS ---
CORS_ORIGIN=http://localhost:5173,https://sekelas-app.vercel.app