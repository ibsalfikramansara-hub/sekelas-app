# ==============================================================================
# SEKELAS — Environment Configuration Template
# Salin file ini menjadi .env untuk konfigurasi lokal atau isi di Vercel Dashboard
# ==============================================================================

# Port lokal server
PORT=3000

# Environment Mode: development | production | test
NODE_ENV=production

# Database URL Fallback (Support PostgreSQL / Supabase / Neon / MySQL)
# Biarkan kosong untuk menggunakan database in-memory / portable default
DATABASE_URL=postgresql://user:password@localhost:5432/sekelas_db?schema=public

# SQLite Serverless Path (otomatis fallback ke /tmp/db.sqlite3 pada lingkungan Vercel)
SQLITE_DB_PATH=/tmp/db.sqlite3

# JWT Authentication Secret
JWT_SECRET=sekelas_jwt_secret_key_super_secure_2026_xe4_ict
JWT_EXPIRES_IN=7d

# Allowed Hosts & CORS Origin
# Sudah mengizinkan localhost, *.vercel.app, dan *.trycloudflare.com
ALLOWED_HOSTS=localhost,127.0.0.1,*.vercel.app,*.trycloudflare.com
CORS_ORIGIN=*

# API Base URL (Otomatis menyesuaikan domain saat di-deploy)
API_BASE_URL=/api
